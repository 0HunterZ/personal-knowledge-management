<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.focusnode.controller.TasksViewController">
    <ScrollPane fx:id="mainScrollPane" fitToWidth="true" styleClass="tasks-scroll-pane">
    
    <HBox spacing="30" styleClass="tasks-main-container" style="-fx-padding: 20px 24px; -fx-background-color: #F8FAFC;">
        
        <!-- Cột Trái (Nội dung chính) -->
        <VBox spacing="20" HBox.hgrow="ALWAYS">
            
            <!-- Header -->
            <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="5">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label styleClass="tasks-header-title" text="Tasks" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                            <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
                                <image>
                                    <Image url="@/images/tasks_icon.png" />
                                </image>
                            </ImageView>
                        </HBox>
                        <Label styleClass="tasks-header-subtitle" text="Plan your day. Focus on what matters." style="-fx-font-size: 14px; -fx-text-fill: #64748B;" />
                    </VBox>
                </HBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox spacing="10" alignment="CENTER">
                    <javafx.scene.control.Button style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;" text="+ New Task" onAction="#createNewTask" />
                    <!-- Toggles -->
                    <HBox spacing="5" alignment="CENTER">
                        <Label styleClass="toggle-btn" text="≡" style="-fx-font-size: 18px; -fx-padding: 4 8;" onMouseClicked="#handleViewToggle" />
                        <Label styleClass="toggle-btn" text="📅" style="-fx-font-size: 16px; -fx-padding: 4 8;" onMouseClicked="#handleViewToggle" />
                    </HBox>
                </HBox>
            </HBox>
            
            <!-- Stats Row -->
            <HBox spacing="20">
                <!-- Completed Stat -->
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="task-stat-card">
                    <VBox styleClass="stat-icon-wrapper" style="-fx-background-color: #DCFCE7;">
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #22C55E;" text="✓" />
                    </VBox>
                    <VBox spacing="2">
                        <Label fx:id="completedCountLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="0" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" text="Completed" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" text="Today" />
                    </VBox>
                </HBox>
                
                <!-- In Progress Stat -->
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="task-stat-card">
                    <VBox styleClass="stat-icon-wrapper" style="-fx-background-color: #EFF6FF;">
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #3B82F6;" text="🎯" />
                    </VBox>
                    <VBox spacing="2">
                        <Label fx:id="inProgressCountLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="0" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" text="In Progress" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" text="Ongoing" />
                    </VBox>
                </HBox>
                
                <!-- Pending Stat -->
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="task-stat-card">
                    <VBox styleClass="stat-icon-wrapper" style="-fx-background-color: #FFFBEB;">
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #F59E0B;" text="⏱" />
                    </VBox>
                    <VBox spacing="2">
                        <Label fx:id="pendingCountLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="0" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" text="Pending" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" text="Upcoming" />
                    </VBox>
                </HBox>

                <!-- Total Stat -->
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="task-stat-card">
                    <VBox styleClass="stat-icon-wrapper" style="-fx-background-color: #F3E8FF;">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #9333EA;" text="📅" />
                    </VBox>
                    <VBox spacing="2">
                        <Label fx:id="totalCountLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="0" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" text="Total Tasks" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" text="This Week" />
                    </VBox>
                </HBox>
            </HBox>
            
            <!-- Filters & Search -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <HBox spacing="10" fx:id="quickFiltersContainer">
                    <Label fx:id="filterAll" styleClass="quick-filter-btn, quick-filter-btn-active" text="All" onMouseClicked="#handleQuickFilter" />
                    <Label fx:id="filterToday" styleClass="quick-filter-btn" text="Today" onMouseClicked="#handleQuickFilter" />
                    <Label fx:id="filterUpcoming" styleClass="quick-filter-btn" text="Upcoming" onMouseClicked="#handleQuickFilter" />
                    <Label fx:id="filterCompleted" styleClass="quick-filter-btn" text="Completed" onMouseClicked="#handleQuickFilter" />
                </HBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <TextField fx:id="searchField" prefWidth="250" promptText="🔍 Search tasks..." styleClass="search-bar" />
                <Label styleClass="btn-outline" text="⚙ Filter" />
            </HBox>
            
            <!-- Task List -->
            <VBox styleClass="tasks-list-container">
                
                <!-- Table Header -->
                <HBox alignment="CENTER_LEFT" styleClass="tasks-list-header">
                    <HBox alignment="CENTER" prefWidth="50">
                        <Label style="-fx-border-color: #CBD5E1; -fx-border-radius: 4; -fx-pref-width: 14; -fx-pref-height: 14;" />
                    </HBox>
                    <Label styleClass="tasks-col-header" prefWidth="250" text="Task" />
                    <Label styleClass="tasks-col-header" prefWidth="120" text="Status" />
                    <Label styleClass="tasks-col-header" prefWidth="100" text="Priority" />
                    <Label styleClass="tasks-col-header" prefWidth="120" text="Due Date" />
                    <Label styleClass="tasks-col-header" prefWidth="100" text="Focus Time" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="tasks-col-header-center" prefWidth="50" alignment="CENTER" text="Actions" />
                </HBox>
                
                <!-- Tasks will be loaded here dynamically -->
                <VBox fx:id="taskListContainer" spacing="0" />
                
                <!-- Footer / Pagination -->
                <HBox alignment="CENTER_LEFT" styleClass="tasks-pagination-footer">
                    <Label fx:id="paginationSummaryLabel" styleClass="tasks-pagination-text" text="Showing 0 tasks" />
                    <Region HBox.hgrow="ALWAYS" />
                    
                    <HBox fx:id="paginationContainer" spacing="5" alignment="CENTER">
                        <!-- Pagination buttons generated dynamically -->
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />
                    
                    <HBox alignment="CENTER" spacing="5">
                        <Label styleClass="tasks-pagination-text" text="Show" />
                        <Label styleClass="btn-outline" style="-fx-padding: 2 8;" text="10 ⌄" />
                        <Label styleClass="tasks-pagination-text" text="per page" />
                    </HBox>
                </HBox>
            </VBox>
        </VBox>
        
        <!-- Cột Phải (Widgets) -->
        <VBox minWidth="300" prefWidth="300" spacing="20">
            <fx:include source="../components/QuoteCard.fxml" />
            <fx:include source="../components/QuickNoteCard.fxml" />
            <fx:include source="../components/DailyStreakCard.fxml" />
        </VBox>
        
    </HBox>
</ScrollPane>
    <StackPane fx:id="editorContainer" visible="false" />
</StackPane>
